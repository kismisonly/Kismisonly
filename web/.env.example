# Semua opsional. Default: Robinhood Mainnet (4663) + kontrak kanonik Doppler.
# Isi di Vercel → Project → Settings → Environment Variables, lalu Redeploy.

# Wallet penerima bagian fee platform. Kosong = creator dapat 95%, Doppler 5%.
VITE_PLATFORM_ADDRESS=
# Bagian platform dalam basis poin dari fee swap (500 = 5%). Maks 4500.
VITE_PLATFORM_SHARE_BPS=500
# Alamat token berakhiran hex ini (mis. ba3). Kosong = acak. Tiap karakter tambahan ~16x lebih lama.
VITE_VANITY_SUFFIX=

VITE_CHAIN_ID=4663
VITE_CHAIN_NAME=Robinhood Chain
VITE_RPC_URL=
VITE_EXPLORER_URL=https://robinhoodchain.blockscout.com
VITE_NATIVE_SYMBOL=ETH
